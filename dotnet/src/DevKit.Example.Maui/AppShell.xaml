<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DevKit.Example.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:login="clr-namespace:DevKit.Example.Maui.Pages.Login"
    xmlns:todoList="clr-namespace:DevKit.Example.Maui.Pages.TodoList"
    Title="DevKit.Example.Maui">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate login:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="TodoList"
        ContentTemplate="{DataTemplate todoList:TodoListPage}"
        Route="TodoListPage" />

</Shell>
